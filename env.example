# Supabase Configuration
# Get these values from your Supabase project dashboard
VITE_SUPABASE_URL=YOUR_SUPABASE_URL
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional: Supabase Service Role Key (for admin operations)
# Only use this in secure server-side environments
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
VITE_APP_NAME=Remix Music
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=A modern music social media app with chat, recommendations, and storefront

# File Upload Configuration
VITE_MAX_FILE_SIZE=10485760 # 10MB in bytes
VITE_ALLOWED_AUDIO_TYPES=audio/mpeg,audio/wav,audio/ogg,audio/mp4
VITE_ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Feature Flags
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_FILE_UPLOAD=true
VITE_ENABLE_COMMENTS=true
VITE_ENABLE_CHAT=true
VITE_ENABLE_STORE=true
VITE_ENABLE_UPLOAD=true

# Stripe Configuration
# Get publishable key from Stripe Dashboard → Developers → API keys
# NOTE: Must use VITE_ prefix — REACT_APP_ prefix is not read by Vite
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...

# Re-Mixed Pro subscription price IDs (server-side only — resolved in API, not exposed to client)
# Create in Stripe Dashboard → Products → Add product → Add price
STRIPE_PRO_MONTHLY_PRICE_ID=price_...   # $4.99/month recurring
STRIPE_PRO_YEARLY_PRICE_ID=price_...    # $47.99/year recurring

# Display prices shown in the Upgrade UI — keep in sync with the Stripe prices above
VITE_PRICE_MONTHLY=$4.99
VITE_PRICE_YEARLY_PER_MONTH=$3.99
VITE_PRICE_YEARLY_TOTAL=$47.99

# Stripe webhook signing secret
# Create in Stripe Dashboard → Developers → Webhooks → Add endpoint
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_failed,
#         payment_intent.succeeded, charge.refunded,
#         charge.dispute.created, charge.dispute.closed   ← storefront purchases
STRIPE_WEBHOOK_SECRET=whsec_...

# Second endpoint, same URL (/api/stripe-webhook), listening to "Connected accounts".
# Event: account.updated (keeps sellers' "ready to sell" status in sync).
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Storefront — track sales
# Platform fee deducted before the artist receives their payout (default 7 %).
# Requires Stripe Connect: musicians complete onboarding via /api/create-stripe-account.
STOREFRONT_PLATFORM_FEE_PERCENT=7
VITE_STOREFRONT_PLATFORM_FEE_PERCENT=7

# Sales kill switch. New purchases are PAUSED unless both are exactly "true".
# Downloads, refunds, disputes and payouts keep working while paused.
# Set per environment in Vercel (e.g. true on Preview with test keys).
STOREFRONT_SALES_ENABLED=false
VITE_STOREFRONT_SALES_ENABLED=false

# Copyright detection
# Layer 1 (metadata blocklist) and Layer 2 (MusicBrainz) run automatically — no keys needed.
# Layer 3: Audd.io audio fingerprinting (free tier: 300 recognitions/month — audd.io)
# If unset, fingerprint check is skipped; layers 1+2 still run.
AUDD_API_KEY=

# Hash blocklist: JSON array of SHA-256 hashes of known copyrighted files
# COPYRIGHT_BLOCKED_HASHES=[]

# DMCA takedown
# RESEND_API_KEY=        (from resend.com)
# ADMIN_EMAIL=           (your email to receive DMCA notices)
# APP_URL=               (your production URL, e.g. https://sypher.app)